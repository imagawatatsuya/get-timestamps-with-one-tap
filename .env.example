# LLM routing for final proofreading
# Select one provider key in PROOFREADING_LLM_PROVIDER:
# openai | anthropic | google | xai | openrouter | deepseek | qwen
PROOFREADING_LLM_PROVIDER=openai

# Shared runtime model selector (fallback)
PROOFREADING_LLM_MODEL=gpt-4.1-mini

# OpenAI
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4.1-mini

# Anthropic (Claude)
ANTHROPIC_API_KEY=your_anthropic_api_key_here
ANTHROPIC_MODEL=claude-3-5-sonnet-latest

# Google (Gemini)
GOOGLE_API_KEY=your_google_api_key_here
GOOGLE_MODEL=gemini-2.0-flash

# xAI (Grok)
XAI_API_KEY=your_xai_api_key_here
XAI_MODEL=grok-2-latest

# OpenRouter (multi-vendor gateway)
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=openai/gpt-4.1-mini

# Chinese LLM vendors (direct)
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_MODEL=deepseek-chat
QWEN_API_KEY=your_qwen_api_key_here
QWEN_MODEL=qwen-max
